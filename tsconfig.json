{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "module": "esnext",
    "moduleResolution": "node",
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "./build"
  },
  "include": ["client/src/**/*", "shell/src/**/*", "client/tests/client/cursor.test.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "tests/**/*"]
}
